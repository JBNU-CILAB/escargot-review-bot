REPO_PATH='/path/to/your/escargot/clone'
REMOTE_NAME='origin'

# ============================================
# LangSmith Tracing (https://smith.langchain.com)
# ============================================
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY='your_langsmith_api_key_here'
LANGCHAIN_PROJECT='escargot-review-bot'

# Number of parallel workers for chunk/hunk concurrency
REVIEW_PARALLEL_WORKERS=3
REVIEW_PARALLEL_PASSES=true

# ============================================
# LLM provider selection (paper-comparison switch)
# ============================================
# Global default provider: ollama | openai
LLM_PROVIDER=openai

# Per-pass model (provider-agnostic). Falls back to OLLAMA_MODEL_* below if unset.
MODEL_DEFECT='gpt-4o'
MODEL_REFACTOR='gpt-4o'
MODEL_COMPILER='gpt-4o'
MODEL_STYLE='gpt-4o'
MODEL_JUDGE='gpt-4o'

# Per-pass provider override (optional, for ablation runs mixing ollama + openai):
# PROVIDER_DEFECT=ollama
# MODEL_DEFECT='qwen3-coder:30b'

# ============================================
# Ollama configuration (used when provider=ollama)
# ============================================
# Ollama daemon endpoint (default 11434 if unset). Set when ollama serves a non-default port.
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# Ollama keep-alive: Keep models loaded long enough during parallel execution
OLLAMA_KEEP_ALIVE=30m

# Legacy per-pass model names (used as fallback when MODEL_* is unset)
OLLAMA_MODEL_DEFECT='model-name'
OLLAMA_MODEL_REFACTOR='model-name'
OLLAMA_MODEL_COMPILER='model-name'
OLLAMA_MODEL_STYLE='model-name'
OLLAMA_MODEL_JUDGE='model-name'

# LLM parameters (Ollama-only; OpenAI inherits temperature, ignores the rest)
OLLAMA_TEMPERATURE=0.1
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_BATCH=256
OLLAMA_REPEAT_PENALTY=1.1
CONFIDENCE_THRESHOLD=0.8

# Timeout / Retry settings (legacy chat_and_parse path only)
OLLAMA_TIMEOUT_SECONDS=1800
OLLAMA_MAX_RETRIES=2

# Delay (seconds) to mitigate rate limits during parallel requests (legacy path only)
INTER_REQUEST_DELAY_SECONDS=0

# ============================================
# OpenAI configuration (used when provider=openai)
# ============================================
# OPENAI_API_KEY='sk-...'
# OPENAI_MAX_TOKENS=4096

# ============================================
# Experiment logging (paper-grade metrics)
# ============================================
# JSONL events: llm_call, pass_summary, judge_call, pr_summary
EXPERIMENT_LOGGING=true
EXPERIMENT_LOG_DIR=experiments
